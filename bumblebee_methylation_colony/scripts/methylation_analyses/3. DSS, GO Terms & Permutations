n_sig_real <- testable_cpgs[
  fdr < fdr_thresh,.N]

################################ Permutation Functions ################################

# Map CpGs to genes
map_cpgs_to_genes <- function(cpg_dt, genes_dt) {
  
  d <- copy(cpg_dt)
  d[, `:=`(cpg_start = pos, cpg_end = pos)]
  setkey(d, chr, cpg_start, cpg_end)
  
  withGenes <- foverlaps(
    d,
    genes_dt,
    by.x = c("chr", "cpg_start", "cpg_end"),
    by.y = c("chr", "start", "end"),
    type = "within",
    nomatch = NA)
  
  unique(withGenes[!is.na(geneID) & geneID != "",
    geneID])}


# Run BP topGO enrichment for each permutation
run_topgo_bp_fast <- function(
    sig_genes,
    universe_BP,
    gene2go_BP,
    nodeSize,
    p_thresh
) {
  
  sig_genes_use <- intersect(sig_genes, universe_BP)
  geneList <- factor(as.integer(universe_BP %in% sig_genes_use))
  
  names(geneList) <- universe_BP
  
  GOdata <- new(
    "topGOdata",
    ontology = "BP",
    allGenes = geneList,
    annot = annFUN.gene2GO,
    gene2GO = gene2go_BP,
    nodeSize = nodeSize)
  
  res_elim <- runTest(
    GOdata, algorithm = "elim",
    statistic = "fisher")
  
  p_elim <- score(res_elim)
  
  names(p_elim)[p_elim < p_thresh]}

# Compare reproductive-status overlap with the two drug term sets
overlap_stat <- function(repro_terms, deci_terms, six_terms) {
  
  b <- length(intersect(
    setdiff(deci_terms, six_terms),
    repro_terms))
  
  c <- length(intersect(
    setdiff(six_terms, deci_terms),
    repro_terms))
  
  a <- length(intersect(
    intersect(deci_terms, six_terms),
    repro_terms))
  
  list(b = b, c = c,a = a,
    diff = b - c)}

################################ Observed GO Overlap ################################

obs <- overlap_stat(go_repro_bp_real, go_deci_bp, go_six_bp)

################################ Permutation Loop ################################

RNGkind("L'Ecuyer-CMRG")
set.seed(seed)

one_replicate <- function(i) {
  perm_idx <- sample(
    nrow(testable_cpgs),
    n_sig_real,
    replace = FALSE)
  
  perm_cpgs <- testable_cpgs[perm_idx,.(chr, pos)]
  perm_genes <- map_cpgs_to_genes(perm_cpgs,genes)
  
  perm_terms <- run_topgo_bp_fast(perm_genes,
    universe_BP,gene2go_BP,
    nodeSize,
    go_p_thresh)
  
  s <- overlap_stat(
    perm_terms,
    go_deci_bp,
    go_six_bp)
  
  c(b = s$b,c = s$c,a = s$a,
    diff = s$diff,
    n_terms = length(perm_terms))}

perm_results <- parallel::mclapply(
  seq_len(n_perm),
  one_replicate,
  mc.cores = n_cores,
  mc.set.seed = TRUE)

perm_results <- as.data.table(do.call(rbind, perm_results))

fwrite(perm_results,
  file.path(out_dir,
    "5aza_vs_6aza_repro_BP_permutation_null.csv"))

################################ Empirical P-values ################################

null_center <- mean(perm_results$diff)

p_two_sided <- (sum(
    abs(perm_results$diff - null_center) >=
      abs(obs$diff - null_center)) + 1) / (n_perm + 1)

p_one_sided <- (sum(perm_results$diff >= obs$diff) + 1) / (n_perm + 1)

summary_out <- data.table(n_perm = n_perm,
  observed_b = obs$b,
  observed_c = obs$c,
  observed_diff = obs$diff,
  null_mean_diff = null_center,
  null_sd_diff = sd(perm_results$diff),
  p_two_sided = p_two_sided,
  p_one_sided = p_one_sided)

fwrite(summary_out,file.path(out_dir,"5aza_vs_6aza_repro_BP_permutation_summary.csv"))
