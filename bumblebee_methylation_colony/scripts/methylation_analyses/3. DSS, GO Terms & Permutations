################################ Preamble ################################

in_dir <- "." 		#Setwd
out_prefix <- "DSS"	#Set prefix
fdr_thresh <- 0.05	#Set FDR threshold
nodeSize <- 5

#Load Files
gene_anno_file <- "/Genomes/Bombus_terrestris/genes_with_start_and_end.txt"	#File stating gene start and end
gff_file       <- "/Genomes/Bombus_terrestris/GCF_910591885.1_iyBomTerr1.2_genomic.gff"	#gff
go_map_file       <- "/Genomes/Bombus_terrestris/BomTerr1.2_Eggnog_go_map.tsv"	#Go terms
treemap_orgdb <- "org.Dm.eg.db"

contrast_names <- c("Control_vs_5aza", "Control_vs_6aza", "5aza_vs_6aza", "repro_vs_sterile")

# Find input files and sort them into the order in which they will be read

file.list <- sort(list.files(
  path = in_dir,
  pattern = "binomial_results\\.txt$",
  full.names = TRUE ))

# Metadata in the same initial order as the sorted input files

Drug <- rep(c("5aza", "5aza", "Control", "Control", "6aza", "6aza"), 6)
Colony <- rep(c("1", "3", "4", "6", "7", "8"),each = 6)

Status <- c("sterile", "repro", "sterile", "repro", "repro", "sterile",
  "sterile", "repro", "sterile", "repro", "sterile", "repro",
  "repro", "sterile", "sterile", "repro", "repro", "sterile",
  "sterile", "repro", "repro", "sterile", "sterile", "repro",
  "sterile", "repro", "sterile", "repro", "repro", "sterile",
  "repro", "sterile", "sterile", "repro", "sterile", "repro")

# Combine the filenames and metadata in reading order
metadata <- data.frame(
  Input_file = basename(file.list),
  Colony = Colony,
  Drug = Drug,
  Reproductive_status = Status,
  stringsAsFactors = FALSE
)

# Reassign control samples whose genomic clustering indicated that the original colony 6 and colony 7 labels were reversed
control_colony6 <- metadata$Drug == "Control" & metadata$Colony == "6"
control_colony7 <- metadata$Drug == "Control" & metadata$Colony == "7"

metadata$Colony[control_colony6] <- "7"
metadata$Colony[control_colony7] <- "6"

# Generate a unique BSseq sample name

metadata$Sample_name <- paste(
  "Col", metadata$Colony, 
  metadata$Drug,
  metadata$Reproductive_status, 
  seq_len(nrow(metadata)),
  sep = "_"
)

# Print metadata in the exact order in which files will be read

cat("\n================ SAMPLE METADATA ================\n")

print(metadata, row.names = FALSE)

cat("=================================================\n\n")

# Read and format DSS input files
samples <- lapply(file.list, function(input_file) {
  
  message("Reading: ", basename(input_file))
  
  dat <- fread(input_file)
  setnames(dat, c("C", "total"), c("X", "N"))
  
  dat <- dat[, .(
    chr = as.character(chr),
    pos = as.integer(pos),
    N   = as.integer(N),
    X   = as.integer(X)
  )]
  
  as.data.frame(dat)
})

# Create the BSseq object

BSobj <- makeBSseqData(dat = samples,sampleNames = metadata$Sample_name)

# Construct the model design
design <- data.frame(
  Drug   = factor(metadata$Drug),
  Colony = factor(metadata$Colony),
  Status = factor(metadata$Reproductive_status)
)

# Print the final correspondence between input files and the DSS design

final_metadata <- data.frame(
  Input_file = metadata$Input_file,
  BSseq_sample = sampleNames(BSobj),
  Colony = design$Colony,
  Drug = design$Drug,
  Reproductive_status = design$Status
)

cat("\n================ FINAL DSS METADATA =============\n")
print(final_metadata, row.names = FALSE)
cat("=================================================\n\n")

################################ PCA ################################

meth <- getMeth(BSobj, type = "raw")

# Retain complete, variable CpGs
meth_filt <- meth[complete.cases(meth), , drop = FALSE]
meth_filt <- meth_filt[apply(meth_filt, 1, sd) > 0, , drop = FALSE]

pca <- prcomp(t(meth_filt), scale. = TRUE)
var_exp <- 100 * pca$sdev^2 / sum(pca$sdev^2)

df <- data.frame(
  pca$x,
  sample = colnames(meth_filt),
  Drug = factor(design$Drug, levels = c("Control", "5aza", "6aza")),
  Colony = design$Colony,
  Status = factor(design$Status, levels = c("sterile", "repro"))
)

# plot
p <- ggplot(
  df,
  aes(PC1, PC2, color = Colony, shape = Drug, fill = Status)
) +
  geom_point(size = 4, stroke = 1.2) +
  scale_shape_manual(
    values = c("Control" = 24, "5aza" = 21, "6aza" = 22)
  ) +
  scale_fill_manual(
    values = c("sterile" = "white", "repro" = "black")
  ) +
  guides(
    fill = guide_legend(
      override.aes = list(shape = 21, color = "black")
    )
  ) +
  labs(
    x = paste0("PC1 (", round(var_exp[1], 1), "%)"),
    y = paste0("PC2 (", round(var_exp[2], 1), "%)"),
    color = "Colony",
    shape = "Drug",
    fill = "Status"
  ) +
  theme_bw(base_size = 14) +
  theme(
    panel.grid.minor = element_blank(),
    legend.position = "right"
  )

ggsave("pca_plot.png", p, width = 7, height = 5, dpi = 300)

################################ Models ################################
design$Status <- relevel(design$Status, ref="sterile")

#Model A
designA <- copy(design)
designA$Drug <- relevel(designA$Drug, ref="Control") #Set reference
fitA <- DMLfit.multiFactor(BSobj, design=designA, formula=~Drug + Status + Colony) #Run model

#Reproductive status
dms_repro <- DMLtest.multiFactor(fitA, coef="Statusrepro") #Perform Wald tests
dms_repro_dt <- as.data.table(dms_repro)
setnames(dms_repro_dt, "fdrs", "fdr")
dms_repro_sig <- dms_repro_dt[!is.na(fdr) & fdr < fdr_thresh] #Select significant sites 
dms_repro_sig[, contrast := "repro_vs_sterile"]
fwrite(dms_repro_sig, paste0(out_prefix, "_repro_vs_sterile_sigCpGs.tsv"), sep="\t") #Write results


#Control vs 6aza
dms_6aza_ctl <- DMLtest.multiFactor(fitA, coef="Drug6aza") #Perform Wald tests
dms_6aza_ctl_dt <- as.data.table(dms_6aza_ctl)
setnames(dms_6aza_ctl_dt, "fdrs", "fdr")
dms_6aza_ctl_dt[, stat := -stat] # Convert 6aza - Control to Control - 6aza
dms_ctl_6aza_sig <- dms_6aza_ctl_dt[!is.na(fdr) & fdr < fdr_thresh]
dms_ctl_6aza_sig[, contrast := "Control_vs_6aza"]
fwrite(dms_ctl_6aza_sig, paste0(out_prefix, "_Control_vs_6aza_sigCpGs.tsv"), sep="\t") #Write results

#Colony
dms_colony <- DMLtest.multiFactor(fitA, term="Colony") #multi-degree-of-freedom Wald test across all colony levels
dms_colony_dt <- as.data.table(dms_colony)
setnames(dms_colony_dt, "pvals", "pval")
dms_colony_dt[, fdr := p.adjust(pval, method = "BH")] #Need to perform fdr because of multi-degree freedom wald test
dms_colony_sig <- dms_colony_dt[!is.na(fdr) & fdr < fdr_thresh] #Select significant sites
dms_colony_sig[, contrast := "Colony_effect"]
fwrite(dms_colony_sig, paste0(out_prefix, "_Colony_effect_sigCpGs.tsv"), sep = "\t") #Write results


#Model B: 5aza reference
designB <- copy(design)
designB$Drug <- relevel(designB$Drug, ref="5aza")
fitB <- DMLfit.multiFactor(BSobj, design=designB, formula=~Drug + Status + Colony)

# Control vs 5aza
dms_ctl_5aza <- DMLtest.multiFactor(fitB, coef="DrugControl") #Perform Wald tests
dms_ctl_5aza_dt <- as.data.table(dms_ctl_5aza)
setnames(dms_ctl_5aza_dt, "fdrs", "fdr")
dms_ctl_5aza_sig <- dms_ctl_5aza_dt[!is.na(fdr) & fdr < fdr_thresh] #Select significant sites
dms_ctl_5aza_sig[, contrast := "Control_vs_5aza"]
fwrite(dms_ctl_5aza_sig, paste0(out_prefix, "_Control_vs_5aza_sigCpGs.tsv"), sep="\t") #Write results

#  6aza vs 5aza
dms_6aza_5aza <- DMLtest.multiFactor(fitB, coef="Drug6aza") #Perform Wald tests
dms_6aza_5aza_dt <- as.data.table(dms_6aza_5aza)
setnames(dms_6aza_5aza_dt, "fdrs", "fdr")
dms_6aza_5aza_dt[, stat := -stat] # Convert 6aza - 5aza to 5aza - 6aza
dms_5aza_6aza_sig <- dms_6aza_5aza_dt[!is.na(fdr) & fdr < fdr_thresh] #Select significant sites
dms_5aza_6aza_sig[, contrast := "5aza_vs_6aza"]
fwrite(dms_5aza_6aza_sig, paste0(out_prefix, "_5aza_vs_6aza_sigCpGs.tsv"), sep="\t") #Write results
cat("[5aza_vs_6aza] sig CpGs:", nrow(dms_5aza_6aza_sig), "\n")

saveRDS(dms_repro_dt, file = "dms_repro_dt.rds")
saveRDS(dms_6aza_ctl_dt, file = "dms_ctl_6aza_dt.rds")
saveRDS(dms_colony_dt, file = "dms_colony_dt.rds")
saveRDS(dms_ctl_5aza_dt, file = "dms_ctl_5aza_dt.rds")
saveRDS(dms_6aza_5aza_dt, file = "dms_5aza_6aza_dt.rds")

# Summarise significant hyper- and hypomethylated CpGs
direction_summary <- data.table(
  contrast = contrast_names,
  hyper = c(
    sum(dms_ctl_5aza_sig$stat > 0, na.rm = TRUE),
    sum(dms_ctl_6aza_sig$stat > 0, na.rm = TRUE),
    sum(dms_5aza_6aza_sig$stat > 0, na.rm = TRUE),
    sum(dms_repro_sig$stat > 0, na.rm = TRUE)
  ),
  hypo = c(
    sum(dms_ctl_5aza_sig$stat < 0, na.rm = TRUE),
    sum(dms_ctl_6aza_sig$stat < 0, na.rm = TRUE),
    sum(dms_5aza_6aza_sig$stat < 0, na.rm = TRUE),
    sum(dms_repro_sig$stat < 0, na.rm = TRUE)
  ),
  total_sig = c(
    nrow(dms_ctl_5aza_sig),
    nrow(dms_ctl_6aza_sig),
    nrow(dms_5aza_6aza_sig),
    nrow(dms_repro_sig)
  )
)

print(direction_summary)

fwrite(
  direction_summary,
  paste0(out_prefix, "_direction_summary.tsv"),
  sep = "\t"
)

