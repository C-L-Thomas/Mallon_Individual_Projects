base_path <- "."

# Fixed (never permuted) BP term-set TSVs, already produced by DSS.R

deci_bp_file  <- file.path(base_path, paste0(out_prefix, "_topGO_Control_vs_5aza_BP.tsv"))
six_bp_file   <- file.path(base_path, paste0(out_prefix, "_topGO_Control_vs_6aza_BP.tsv"))
repro_bp_file <- file.path(base_path, paste0(out_prefix, "_topGO_repro_vs_sterile_BP.tsv"))

#Parameters
go_p_thresh <- 0.05  # elimFisher threshold used to define an "enriched" BP term, matches DSS.R
n_perm <- 2000         # timing pilot; increase after checking runtime and validation
out_dir <- file.path(base_path, paste0("Permutation_", n_perm))
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
seed   <- 1

#Threading

use_parallel <- TRUE   # set TRUE and install/load `parallel` if you want to speed this up;
n_cores <- 4             # see PART 5 for the swap-in

## ---- 1.2: fixed Decitabine / 6-aza BP term sets (never permuted) ----

go_deci_bp  <- unique(na.omit(fread(deci_bp_file)$GO.ID))

go_six_bp   <- unique(na.omit(fread(six_bp_file)$GO.ID))

go_repro_bp_real <- unique(na.omit(fread(repro_bp_file)$GO.ID))   # the REAL, published repro term set

cat(sprintf("Fixed sets: Decitabine BP terms = %d, 6-aza BP terms = %d, real repro BP terms = %d\n",
            
            length(go_deci_bp), length(go_six_bp), length(go_repro_bp_real)))

# Full repro_vs_sterile CpG results

dms_repro_full <- copy(dms_repro_dt)

dms_repro_full[, `:=`(
